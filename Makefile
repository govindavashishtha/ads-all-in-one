# ads-autopilot — developer targets. Requires uv (https://docs.astral.sh/uv/).
# Local Postgres defaults; override on the command line or in the environment.
DATABASE_URL      ?= postgresql+psycopg://ads:ads@127.0.0.1:5432/ads_autopilot
TEST_DATABASE_URL ?= postgresql+psycopg://ads:ads@127.0.0.1:5432/ads_autopilot_test
ALEMBIC           := uv run alembic -c db/alembic.ini
COMPOSE           ?= docker compose

.PHONY: help setup lint fmt test test-unit migrate downgrade migration bootstrap up down logs compose-config

help:
	@grep -E '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  %-16s %s\n",$$1,$$2}'

setup: ## install pinned deps (incl. dev) into .venv
	uv sync --frozen --all-groups

lint: ## ruff (lint + format check) and mypy --strict
	uv run ruff check .
	uv run ruff format --check .
	uv run mypy

fmt: ## auto-format
	uv run ruff format .
	uv run ruff check --fix .

test: ## all tests; integration tests use TEST_DATABASE_URL (disposable DB)
	TEST_DATABASE_URL=$(TEST_DATABASE_URL) uv run pytest

test-unit: ## tests that need no database
	uv run pytest tests/unit tests/contract tests/property

migrate: ## alembic upgrade head on DATABASE_URL
	DATABASE_URL=$(DATABASE_URL) $(ALEMBIC) upgrade head

downgrade: ## alembic downgrade one revision on DATABASE_URL
	DATABASE_URL=$(DATABASE_URL) $(ALEMBIC) downgrade -1

migration: ## new autogenerated revision: make migration m="add foo"
	DATABASE_URL=$(DATABASE_URL) $(ALEMBIC) revision --autogenerate -m "$(m)"

bootstrap: ## seed client + rules/limits v1 on first start (no-op afterwards)
	DATABASE_URL=$(DATABASE_URL) uv run python -m engine.bootstrap

up: ## build and start postgres, engine, api, dashboard, proxy
	$(COMPOSE) up -d --build

down:
	$(COMPOSE) down

logs:
	$(COMPOSE) logs -f --tail=200

compose-config: ## validate docker-compose.yml
	$(COMPOSE) config --quiet
