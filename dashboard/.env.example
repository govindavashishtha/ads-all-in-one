# Build-time values (BUILD_PLAN §7.2, §18). Changing them needs a rebuild.
NEXT_PUBLIC_BASE_PATH=/ads-autopilot
NEXT_PUBLIC_API_URL=/ads-autopilot/api/v1
# true = no backend; every page shows clearly labelled EXAMPLE data.
NEXT_PUBLIC_MOCK_API=false
# Name of the non-httpOnly CSRF cookie set by the API for double-submit (§17).
NEXT_PUBLIC_CSRF_COOKIE=aa_csrf
